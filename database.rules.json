{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "sessions": {
          "$sessionId": {
            ".validate": "newData.hasChildren(['schemaVersion','deviceId','startedAt']) && (!data.child('endedAt').exists() || newData.child('endedAt').exists())",
            "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 2 && (!data.exists() || newData.val() === data.val())" },
            "deviceId": { ".validate": "newData.isString() && newData.val() === 'sleep-tracker-simulator' && (!data.exists() || newData.val() === data.val())" },
            "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())" },
            "endedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() >= newData.parent().child('startedAt').val() && (!data.exists() || newData.val() === data.val())" },
            "measurements": {
              "$measurementId": {
                ".validate": "newData.hasChildren(['measurementId','deviceId','sensorType','x','y','z','value','timestamp','movementState','movementIntensity','bleConnected','restState'])",
                "measurementId": { ".validate": "newData.isString() && newData.val() === $measurementId" },
                "deviceId": { ".validate": "newData.isString() && newData.val() === 'sleep-tracker-simulator'" },
                "sensorType": { ".validate": "newData.isString() && newData.val() === 'ACCELEROMETER'" },
                "x": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "y": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "z": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "value": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000" },
                "movementState": { ".validate": "newData.isString() && (newData.val() === 'STILL' || newData.val() === 'MOVEMENT' || newData.val() === 'UNAVAILABLE')" },
                "movementIntensity": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "heartRateBpm": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 250" },
                "bleConnected": { ".validate": "newData.isBoolean()" },
                "restState": { ".validate": "newData.isString() && (newData.val() === 'MONITORING' || newData.val() === 'ACTIVE' || newData.val() === 'RESTING' || newData.val() === 'POSSIBLE_SLEEP')" },
                "$other": { ".validate": false }
              }
            },
            "ruleEvents": {
              "$eventId": {
                ".validate": "newData.hasChildren(['eventId','ruleId','ruleName','timestamp','source','sourceValue','requestedAction','actuatorResult','bleDeliveryResult','schemaVersion'])",
                "eventId": { ".validate": "newData.isString() && newData.val() === $eventId" },
                "ruleId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())" },
                "ruleName": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128 && (!data.exists() || newData.val() === data.val())" },
                "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000 && (!data.exists() || newData.val() === data.val())" },
                "source": { ".validate": "newData.isString() && (newData.val() === 'ACCELEROMETER_X' || newData.val() === 'ACCELEROMETER_Y' || newData.val() === 'ACCELEROMETER_Z' || newData.val() === 'MOVEMENT_INTENSITY' || newData.val() === 'ML_CLASS')" },
                "sourceValue": { ".validate": "newData.isString() && newData.val().length <= 128" },
                "sensorTimestampNanos": { ".validate": "newData.isNumber() && newData.val() > 0" },
                "predictionId": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 128" },
                "mlClass": { ".validate": "newData.isString() && (newData.val() === 'REST' || newData.val() === 'RESTLESS' || newData.val() === 'ACTIVE')" },
                "mlConfidence": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                "requestedAction": { ".validate": "newData.isString() && (newData.val() === 'VIBRATION_PULSE' || newData.val() === 'MOCK_BLE_ALERT' || newData.val() === 'VISIBLE_ALERT' || newData.val() === 'CRITICAL_ALERT') && (!data.exists() || newData.val() === data.val())" },
                "actuatorResult": { ".validate": "newData.isString() && newData.val().length <= 256 && (!data.exists() || newData.val() === data.val())" },
                "bleDeliveryResult": { ".validate": "newData.isString() && newData.val().length <= 256 && (!data.exists() || newData.val() === data.val())" },
                "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 1" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "sessionSummaries": {
          "$sessionId": {
            ".validate": "newData.hasChildren(['sessionId','startedAt','endedAt','observationDurationMs','lowMotionFraction','restlessFraction','activeFraction','sourceMode','qualityStatus','schemaVersion'])",
            "sessionId": { ".validate": "newData.isString() && newData.val() === $sessionId" },
            "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())" },
            "endedAt": { ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('startedAt').val() && (!data.exists() || newData.val() === data.val())" },
            "observationDurationMs": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "lowMotionFraction": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "restlessFraction": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "activeFraction": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
            "meanHeartRateBpm": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 250" },
            "sourceMode": { ".validate": "newData.isString()" },
            "placement": { ".validate": "newData.isString()" },
            "qualityStatus": { ".validate": "newData.isString()" },
            "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 2" },
            "$other": { ".validate": false }
          }
        },
        "control": {
          "sleep-tracker-simulator": {
            "vibrationEnabled": { ".validate": "newData.isBoolean()" },
            "flashlightEnabled": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
