{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "sessions": {
          "$sessionId": {
            ".validate": "newData.hasChildren(['schemaVersion','deviceId','startedAt']) && (!data.child('endedAt').exists() || newData.child('endedAt').exists())",
            "schemaVersion": { ".validate": "newData.isNumber() && newData.val() === 2 && (!data.exists() || newData.val() === data.val())" },
            "deviceId": { ".validate": "newData.isString() && newData.val() === 'sleep-tracker-simulator' && (!data.exists() || newData.val() === data.val())" },
            "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && (!data.exists() || newData.val() === data.val())" },
            "endedAt": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() >= newData.parent().child('startedAt').val() && (!data.exists() || newData.val() === data.val())" },
            "measurements": {
              "$measurementId": {
                ".validate": "newData.hasChildren(['measurementId','deviceId','sensorType','x','y','z','value','timestamp','movementState','movementIntensity','bleConnected','restState'])",
                "measurementId": { ".validate": "newData.isString() && newData.val() === $measurementId" },
                "deviceId": { ".validate": "newData.isString() && newData.val() === 'sleep-tracker-simulator'" },
                "sensorType": { ".validate": "newData.isString() && newData.val() === 'ACCELEROMETER'" },
                "x": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "y": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "z": { ".validate": "newData.isNumber() && newData.val() >= -200 && newData.val() <= 200" },
                "value": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "timestamp": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000" },
                "movementState": { ".validate": "newData.isString() && (newData.val() === 'STILL' || newData.val() === 'MOVEMENT' || newData.val() === 'UNAVAILABLE')" },
                "movementIntensity": { ".validate": "newData.isNumber() && newData.val() >= 0" },
                "heartRateBpm": { ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 250" },
                "bleConnected": { ".validate": "newData.isBoolean()" },
                "restState": { ".validate": "newData.isString() && (newData.val() === 'MONITORING' || newData.val() === 'ACTIVE' || newData.val() === 'RESTING' || newData.val() === 'POSSIBLE_SLEEP')" },
                "$other": { ".validate": false }
              }
            },
            "$other": { ".validate": false }
          }
        },
        "control": {
          "sleep-tracker-simulator": {
            "vibrationEnabled": { ".validate": "newData.isBoolean()" },
            "flashlightEnabled": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
