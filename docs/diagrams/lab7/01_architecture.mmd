flowchart LR
  SM[Android SensorManager] --> DS[AndroidAccelerometerDataSource]
  DS --> SVM[SensorViewModel]
  SVM --> ML[ActivityClassifier TFLite]
  SVM --> RH[Room sensor history]
  SVM --> SR[Smart Rule Engine]
  ML --> SR
  SR --> TX[Room atomic event coordinator]
  TX --> EX[Room rule executions]
  TX --> OUT[Room gated cloud outbox]
  SR --> ACT[AndroidSmartActuator]
  SR --> BLE[MockBleConnector]
  OUT --> WM[WorkManager]
  WM --> REC[Crash reconciler]
  REC --> EX
  REC --> OUT
  WM --> FB[Firebase RTDB]
  SVM --> UI[Compose Dashboard]
  ML --> UI
  RH --> UI
  BLE --> UI
  FB --> UI
